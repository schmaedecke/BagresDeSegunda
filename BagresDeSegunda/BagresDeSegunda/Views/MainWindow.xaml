<Window x:Class="BagresDeSegunda.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:BagresDeSegunda.Converters"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="clr-namespace:BagresDeSegunda.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="Bagres de Segunda" Height="700" Width="1100"
        Background="#F4F9F9">
    
    <Window.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </Window.Resources>


    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,20,0">

                <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Jogadores" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtNovoJogador" Padding="10" VerticalContentAlignment="Center" Text="{Binding NomeNovoJogador, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="+ Adicionar" Margin="10,0,0,0" Padding="15,5" 
                                    Background="#0B0E1E" Foreground="White" Command="{Binding AdicionarJogadorCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding JogadoresDisponiveis}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#E9ECEF" CornerRadius="10" Margin="0,0,8,8" Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"/>

                                            <Button Content="✕" 
                            Command="{Binding DataContext.ExcluirJogadorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            FontSize="10" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            Foreground="#C0392B"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Registrar Novo Jogo" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Time 1" FontSize="16" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <Border Background="Azure" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2">
                                        <TextBlock Text="{Binding TotalGolsT1, StringFormat='{}{0} gols'}" Foreground="DarkBlue" FontWeight="Bold"/>
                                    </Border>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="cbTime1" 
                                              ItemsSource="{Binding JogadoresDisponiveis}" 
                                              DisplayMemberPath="Nome" 
                                              Margin="0,0,5,0"/>

                                    <Button Grid.Column="1" 
                                            Content="➕" 
                                            Padding="10,0"
                                            Command="{Binding EscalarTime1Command}" 
                                            CommandParameter="{Binding SelectedItem, ElementName=cbTime1}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Time2Escalado}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8F9FA" Margin="0,2" Padding="10" CornerRadius="5">
                                                <Grid>
                                                    <TextBlock Text="{Binding Jogador.Nome}" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding Gols, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="40" HorizontalAlignment="Right" TextAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Nenhum jogador adicionado" 
                                           Foreground="Gray" 
                                           FontStyle="Italic" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,20"
                                           Visibility="{Binding Time2Escalado.Count, Converter={StaticResource CountToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Time 2" FontSize="16" VerticalAlignment="Center" FontWeight="Bold"/>
                                    <Border Background="#FFE1E1" CornerRadius="10" HorizontalAlignment="Right" Padding="8,2">
                                        <TextBlock Text="{Binding TotalGolsT2, StringFormat='{}{0} gols'}" Foreground="#E74C3C" FontWeight="Bold"/>
                                    </Border>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="cbTime2" 
                                              ItemsSource="{Binding JogadoresDisponiveis}" 
                                              DisplayMemberPath="Nome" 
                                              Margin="0,0,5,0"/>

                                    <Button Grid.Column="1" 
                                            Content="➕" 
                                            Padding="10,0"
                                            Command="{Binding EscalarTime2Command}" 
                                            CommandParameter="{Binding SelectedItem, ElementName=cbTime2}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Time2Escalado}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8F9FA" Margin="0,2" Padding="10" CornerRadius="5">
                                                <Grid>
                                                    <TextBlock Text="{Binding Jogador.Nome}" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding Gols, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="40" HorizontalAlignment="Right" TextAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Nenhum jogador adicionado" 
                                           Foreground="Gray" 
                                           FontStyle="Italic" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,20"
                                           Visibility="{Binding Time2Escalado.Count, Converter={StaticResource CountToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="+ Salvar Jogo" 
                                Command="{Binding SalvarJogoCommand}"
                                Margin="0,20,0,0" Background="#0B0E1E" 
                                Foreground="White" Padding="20,10" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Histórico de Jogos" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border Background="White" CornerRadius="15" Padding="20">
                    <Grid>
                        <TextBlock Text="17/12/2025, 19:52" Foreground="Gray" VerticalAlignment="Top"/>
                        <Border Background="#FEF9E7" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,2">
                            <TextBlock Text="Empate" Foreground="#F1C40F" FontSize="12"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <TextBlock Text="Time 1" Margin="0,0,40,0"/>
                            <TextBlock Text="0 - 0" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="Time 2" Margin="40,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="20">
            <StackPanel>
                <TextBlock Text="🏆 Classificação Geral" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                <ItemsControl ItemsSource="{Binding RankingGeral}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#F1C40F" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Nome}" FontWeight="Bold" FontSize="16"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>